  "required": [
    "name",
    "base",
    "color",
    "modes"
  ],
  "additionalProperties": false,
  "$defs": {
    "hex": {
      "type": "object",
      "properties": {
        "$value": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "$value"
      ],
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "properties": {
        "$value": {
          "type": "string",
          "pattern": "^\\{[a-z]+\\.[0-9]+\\}( / (0|1|0?\\.[0-9]+))?$"
        }
      },
      "required": [
        "$value"
      ],
      "additionalProperties": false
    },
    "number": {
      "type": "object",
      "properties": {
        "$type": {
          "const": "number"
        },
        "$value": {
          "type": "number"
        },
        "$description": {
          "type": "string"
        }
      },
      "required": [
        "$value"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "properties": {
        "bg": {
          "$ref": "#/$defs/color"
        },
        "fg": {
          "$ref": "#/$defs/color"
        }
      },
