{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rune-ui/theme.schema.json",
  "title": "rune-ui theme",
  "description": "A rune-ui theme: base knobs, colour ramps (tier 1), and light and dark modes of roles (tier 2), state alphas and component tokens (tier 3). Shaped like W3C design tokens ($type, $value, {aliases}). Unknown keys are errors.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "base": {
      "type": "object",
      "properties": {
        "spacing": {
          "$ref": "#/$defs/number"
        },
        "radius": {
          "$ref": "#/$defs/number"
        },
        "density": {
          "$ref": "#/$defs/number"
        },
        "type-scale": {
          "$ref": "#/$defs/number"
        },
        "corners": {
          "type": "object",
          "properties": {
            "$type": {
              "const": "string"
            },
            "$value": {
              "enum": [
                "continuous",
                "round"
              ]
            },
            "$description": {
              "type": "string"
            }
          },
          "required": [
            "$value"
          ],
          "additionalProperties": false
        },
        "font": {
          "type": "object",
          "properties": {
            "$type": {
              "const": "string"
            },
            "$value": {
              "enum": [
                "inter",
                "system",
                "serif",
                "mono"
              ]
            },
            "$description": {
              "type": "string"
            }
          },
          "required": [
            "$value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "spacing",
        "radius",
        "density",
        "type-scale",
        "corners",
        "font"
      ],
      "additionalProperties": false
    },
