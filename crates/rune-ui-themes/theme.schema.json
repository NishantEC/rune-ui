{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rune-ui/theme.schema.json",
  "title": "rune-ui theme",
  "description": "A rune-ui theme: base knobs, colour ramps (tier 1), and light and dark modes of roles (tier 2), state alphas and component tokens (tier 3). Shaped like W3C design tokens ($type, $value, {aliases}). Unknown keys are errors.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "base": {
      "type": "object",
      "properties": {
        "spacing": {
          "$ref": "#/$defs/number"
        },
        "radius": {
          "$ref": "#/$defs/number"
        },
        "density": {
          "$ref": "#/$defs/number"
        },
        "type-scale": {
          "$ref": "#/$defs/number"
        },
        "corners": {
          "type": "object",
          "properties": {
            "$type": {
              "const": "string"
            },
            "$value": {
              "enum": [
                "continuous",
                "round"
              ]
            },
            "$description": {
              "type": "string"
            }
          },
          "required": [
            "$value"
          ],
          "additionalProperties": false
        },
        "font": {
          "type": "object",
          "properties": {
            "$type": {
              "const": "string"
            },
            "$value": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "A font's name: inter, system, serif or mono, or one an app installs from a font item (geist, ibm-plex-sans, ...). A name the app has not installed is an error when the theme loads."
            },
            "$description": {
              "type": "string"
            }
          },
          "required": [
            "$value"
          ],
          "additionalProperties": false
        },
        "keys-font": {
          "type": "object",
          "properties": {
            "$type": {
              "const": "string"
            },
            "$value": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "The face of keycaps and menu shortcuts: a font's name, as for font. Optional: the theme's own font when left out."
            },
            "$description": {
              "type": "string"
            }
          },
          "required": [
            "$value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "spacing",
        "radius",
        "density",
        "type-scale",
        "corners",
        "font"
      ],
      "additionalProperties": false
